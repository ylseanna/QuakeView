{
  "name": "quakeview",
  "description": "Interactive earthquake catalog visualiser",
  "author": "Ylse Anna de Vries (ylseanna) <yad2@hi.is>",
  "version": "0.8.0",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/ylseanna/QuakeView",
  "private": true,
  "main": "out/build/main.js",
  "proxy": "localhost:8100",
  "type": "module",
  "scripts": {
    "next:dev": "next dev -p 8090",
    "next:build": "next build",
    "next:start": "next start -p 8090",
    "next:lint": "next lint",
    "flask:dev": "flask --debug --app flask/app.py run -h localhost -p 8100",
    "flask:build": "pyinstaller -F flask/app.py --distpath flask/dist --workpath flask/build",
    "flask:start": "./flask/dist/app",
    "vite:dev": "electron-vite dev",
    "vite:prebuild": "electron-vite build",
    "electron:dist": "electron-builder",
    "electron:dist:dir": "electron-builder --dir",
    "electron:dist:deb": "electron-builder --linux deb",
    "electron:dist:msi": "electron-builder --win nsis",
    "electron:build": "tsup",
    "electron:build_watch": "tsup --watch",
    "electron:dev": "npm-run-all --parallel electron:build_watch electron:watch",
    "electron:watch": "cross-env NODE_ENV='development' nodemon",
    "build": "run-s next:build flask:build",
    "dist": "run-s electron:dist",
    "dev": "npm-run-all --parallel next:dev flask:dev vite:dev"
  },
  "build": {
    "asar": true,
    "executableName": "QuakeView",
    "appId": "frl.ylse.quakeview",
    "asarUnpack": [
      "node_modules/next",
      "node_modules/@img",
      "node_modules/sharp",
      "**\\*.{node,dll}"
    ],
    "files": [
      "out",
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "!**/.env",
          "!**/package.json"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static"
      },
      {
        "from": "public",
        "to": "app/public"
      },
      {
        "from": "flask/dist",
        "to": "app/flask"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "appImage"
      ],
      "artifactName": "quakeview_${version}_${env.OS}.${ext}",
      "category": "Science"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "buildResources": "resources",
      "output": "release"
    }
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@formatjs/intl-datetimeformat": "^7.2.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/material-nextjs": "^7.3.7",
    "@mui/types": "^7.4.10",
    "@mui/x-data-grid": "^7.29.12",
    "@next/bundle-analyzer": "^15.5.9",
    "@react-hooks-library/core": "^0.6.2",
    "@turf/mask": "^7.3.2",
    "@types/d3": "^7.4.3",
    "@types/web": "^0.0.228",
    "custom-event-polyfill": "^1.0.7",
    "d3": "^7.9.0",
    "deck.gl": "^9.2.6",
    "electron-router-dom": "^2.1.0",
    "electron-vite": "^5.0.0",
    "get-port-please": "^3.2.0",
    "immer": "^10.2.0",
    "lodash": "^4.17.21",
    "mapbox-gl": "^3.18.0",
    "maplibre-gl": "^4.7.1",
    "material-ui-popup-state": "^5.3.6",
    "mdi-material-ui": "^7.9.4",
    "mui-color-input": "^7.0.0",
    "next": "^16.1.6",
    "next-intl": "^4.8.2",
    "nodemon": "^3.1.11",
    "react": "^19.2.3",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.3",
    "react-json-tree": "^0.20.0",
    "react-map-gl": "^7.1.9",
    "strftime": "^0.10.3",
    "use-animation-frame": "^0.2.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "^0.25.4",
    "@eslint/eslintrc": "^3.3.3",
    "@types/lodash": "^4.17.23",
    "@types/node": "^20.19.29",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "cross-env": "7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.1.8",
    "npm-run-all": "4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
